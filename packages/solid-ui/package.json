{
  "name": "@boltronx/solid-ui",
  "version": "0.2.0",
  "description": "Simple, themeable SolidJS components that work with plain HTML forms.",
  "license": "MIT",
  "author": "Gabriel Jefferson Boltron <gabrielboltron@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boltronx/solid-ui.git",
    "directory": "packages/solid-ui"
  },
  "homepage": "https://boltronx.github.io/solid-ui/",
  "bugs": {
    "url": "https://github.com/boltronx/solid-ui/issues"
  },
  "keywords": [
    "solid",
    "solidjs",
    "components",
    "ui",
    "forms"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/vite.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/build-css.mjs",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:js": "tsup --watch",
    "dev:css": "node scripts/build-css.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css components.css",
    "prepack": "node scripts/copy-meta.mjs"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "publint": "^0.3.25",
    "solid-js": "^1.9.17",
    "tsup": "^9.0.0",
    "tsup-preset-solid": "^2.2.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
