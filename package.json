{
  "name": "solid-ui-workspace",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "dev": "pnpm --filter @boltronx/solid-ui build && pnpm --parallel --filter @boltronx/solid-ui --filter docs dev",
    "dev:start": "pnpm --filter @boltronx/solid-ui build && pnpm --parallel --filter @boltronx/solid-ui --filter start-fixture dev",
    "build": "pnpm --filter @boltronx/solid-ui build && pnpm --filter docs build",
    "test": "pnpm --filter @boltronx/solid-ui test",
    "test:coverage": "pnpm --filter @boltronx/solid-ui test:coverage",
    "test:start": "pnpm --filter @boltronx/solid-ui build && pnpm test:start:fixture",
    "test:start:fixture": "pnpm --filter start-fixture build && pnpm --filter start-fixture test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:package": "pnpm --filter @boltronx/solid-ui lint:package",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spellcheck": "cspell . --no-progress --gitignore",
    "check": "pnpm format:check && pnpm spellcheck && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:start:fixture && pnpm lint:package",
    "update-deps": "pnpm up -r -Li"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
